# Copy this file to ".env" and put your own values in it.
# The real .env file is never uploaded to GitHub (policy P4).

# A long random string. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Leave DATABASE_URL unset to use the built-in SQLite file for local demos/tests.
# For MySQL, set this to the dedicated app user's connection URL. URL-encode any
# reserved characters in the password (for example @ becomes %40).
# DATABASE_URL=mysql+pymysql://parceltrack_app:YOUR_DB_PASSWORD@127.0.0.1:3306/parceltrack

# Set to 1 once the site runs on HTTPS
SESSION_COOKIE_SECURE=0
