# Copy this file to ".env" and put your own values in it.
# The real .env file is never uploaded to GitHub (policy P4).

# A long random string. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Leave this out to use the built-in SQLite file for the demo.
# For MySQL (later, on the cloud server):
# DATABASE_URL=mysql+pymysql://parceltrack_user:YOUR_DB_PASSWORD@localhost/parceltrack

# Set to 1 once the site runs on HTTPS
SESSION_COOKIE_SECURE=0
